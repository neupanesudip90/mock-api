generator client {
  provider = "prisma-client"
  output   = "../src/generated"
   moduleFormat = "commonjs" 
}

datasource db {
  provider = "postgresql"
}


//enums for https methos
enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

//enums for projects status
enum ProjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED  // Archived projects are read-only and cannot be modified or deleted.
}

//enum for ratelimiting strategies
enum RateLimitStrategy {
  FIXED_WINDOW
  SLIDING_LOG
  TOKEN_BUCKET
  LEAKY_BUCKET
}

//models
model User{
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String
  name                     String?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpiry      DateTime?
  tokenVersion             Int       @default(0)
  projects  Project[]  // A user can have multiple projects. it is a one-to-many relationship   between user and project.project also a separate model in the database
   otpCodes      OtpCode[]  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")  // Map to "users" table in the database
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?  // null = not used yet
  createdAt DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([code, type])
  @@map("otp_codes")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Project{
  id        String   @id @default(uuid())
  userId    String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  //apikey hash for security
  apiKeyHash String @unique  // Store the hashed API key for security. This field is unique to ensure that each API key is distinct.
  apiKeyPrefix String @unique // Store the prefix of the API key for quick lookup. This field is unique to ensure that each prefix is distinct. api prefix is the first 8 characters of the API key, it is used to quickly identify the project associated with an incoming request without needing to hash the entire API key.

  //default rate limiting for the project
  defaultRateLimitMax Int @default(1000) // Default maximum number of requests allowed within the rate limit window. This can be overridden by specific endpoints if needed.

  defaultRateLimitWindow Int @default(60) // Default time window for rate limiting in  seconds. This can be overridden by specific endpoints if needed.

   defaultRateLimitStrategy RateLimitStrategy @default(FIXED_WINDOW) // Default rate limiting strategy for the project. This can be overridden by specific endpoints if needed.

    // 🔑 API Keys Relation (Refactored from inline fields)
  apiKeys   ApiKey[] // A project can have multiple API keys. This sets up a one-to-many relationship to the ApiKey model.

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)  // A project belongs to a user. This sets up a foreign key relationship to the User model. If the user is deleted, all their projects will also be deleted (cascade delete).
  endpoints Endpoint[]
  logs UsageLog[]

  @@index([userId])
  @@map("projects")
}

// Separate model for API keys to enhance security and manageability.it helps to store the API keys securely by hashing them and allows for better management of multiple keys per project, including tracking usage and revocation without affecting the project itself.
model ApiKey {
  id        String   @id @default(uuid())
  projectId String
  
  name      String   // e.g., "Production Key", "Dev Key"
  keyHash   String   @unique // 🔒 Store hash, never plain text
  keyPrefix String  // e.g., "sk_live_..." for UI display
  
  lastUsedAt DateTime?
  revoked    Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_keys")
}

model Endpoint {
  id        String     @id @default(uuid())
  projectId String
  
  path      String     // e.g., "/users", "/products/:id"
  method    HttpMethod
  
  // 🧠 Dynamic Schema Storage: JSONB allows flexible, queryable user schemas
  responseSchema Json   
  statusCode     Int   @default(200)
  delayMs        Int   @default(0) // Simulate network latency

  // ⚡ Rate Limiting Configuration
  rateLimitEnabled  Boolean           @default(true)
  rateLimitStrategy RateLimitStrategy @default(FIXED_WINDOW)
  rateLimitMax      Int               @default(60)
  rateLimitWindow   Int               @default(60) // seconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    UsageLog[]

  // Prevent duplicate routes in the same project
  @@unique([projectId, method, path])
  @@index([projectId])
  @@map("endpoints") // Map to "endpoints" table in the database. it creates a table named "endpoints" in the database to store the endpoint data.
}

model UsageLog {
  id           String   @id @default(uuid())
  endpointId   String
  projectId    String   // 🚀 Denormalized: Avoids JOINs for analytics queries
  
  ipAddress    String?
  userAgent    String?
  statusCode   Int
  responseTimeMs Int
  rateLimitHit Boolean  @default(false)
  timestamp    DateTime @default(now())


  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 📊 Critical Indexes for Analytics Performance
  @@index([projectId, timestamp])
  @@index([endpointId, timestamp])
   @@index([timestamp])

  @@map("usage_logs")
}