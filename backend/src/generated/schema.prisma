generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RateLimitStrategy {
  FIXED_WINDOW
  SLIDING_LOG
  TOKEN_BUCKET
  LEAKY_BUCKET
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  emailVerified Boolean  @default(false)
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
  otpCodes OtpCode[]

  @@map("users")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([code, type])
  @@map("otp_codes")
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  defaultRateLimitMax      Int               @default(1000)
  defaultRateLimitWindow   Int               @default(60)
  defaultRateLimitStrategy RateLimitStrategy @default(FIXED_WINDOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]
  endpoints Endpoint[]
  logs      UsageLog[]

  @@unique([userId, name])
  @@index([userId])
  @@map("projects")
}

model ApiKey {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  keyHash    String
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([keyPrefix])
  @@index([keyPrefix, isActive])
  @@map("api_keys")
}

model Endpoint {
  id        String     @id @default(uuid())
  projectId String
  path      String
  method    HttpMethod

  responseSchema Json
  statusCode     Int  @default(200)
  delayMs        Int  @default(0)

  rateLimitEnabled  Boolean           @default(true)
  rateLimitStrategy RateLimitStrategy @default(FIXED_WINDOW)
  rateLimitMax      Int               @default(60)
  rateLimitWindow   Int               @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    UsageLog[]

  @@unique([projectId, method, path])
  @@index([projectId])
  @@map("endpoints")
}

model UsageLog {
  id             String   @id @default(uuid())
  endpointId     String
  projectId      String
  ipAddress      String?
  userAgent      String?
  statusCode     Int
  responseTimeMs Int
  rateLimitHit   Boolean  @default(false)
  timestamp      DateTime @default(now())

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, timestamp])
  @@index([endpointId, timestamp])
  @@index([timestamp])
  @@map("usage_logs")
}
